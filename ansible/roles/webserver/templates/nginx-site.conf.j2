server {
    listen 80 default_server;
    server_name _;

    root /var/www/html;
    index index.html;

    access_log /var/log/nginx/webserver_access.log;

    location / {
        try_files $uri $uri/ =404;
    }

    location /health {
        default_type application/json;
        return 200 '{"status":"UP","server":"{{ inventory_hostname }}","role":"webserver"}';
        add_header Content-Type application/json;
    }

    location /nginx-status {
        stub_status on;
        access_log  off;
        allow 127.0.0.1;
        deny all;
    }
}
