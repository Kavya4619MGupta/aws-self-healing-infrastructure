<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Automated Self-Healing Infrastructure</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0a0e27 0%, #0d1b4b 50%, #0a2766 100%);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #e0e8ff;
    }

    h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-align: center;
      margin-bottom: 2rem;
      text-shadow: 0 0 20px rgba(100, 160, 255, 0.6);
    }

    .card {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(100, 160, 255, 0.25);
      border-radius: 16px;
      padding: 2.5rem 3rem;
      max-width: 480px;
      width: 90%;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 40px rgba(0, 50, 150, 0.4);
    }

    .card h2 {
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #7eb8ff;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid rgba(100, 160, 255, 0.2);
      padding-bottom: 0.75rem;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .info-row:last-of-type {
      border-bottom: none;
    }

    .info-label {
      font-size: 0.85rem;
      color: #8aaedd;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .info-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: #ddeeff;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 200, 100, 0.15);
      border: 1px solid rgba(0, 200, 100, 0.4);
      color: #00e676;
      border-radius: 20px;
      padding: 0.2rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .dot {
      width: 10px;
      height: 10px;
      background: #00e676;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.7); }
      70%  { box-shadow: 0 0 0 10px rgba(0, 230, 118, 0); }
      100% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0); }
    }

    footer {
      margin-top: 2.5rem;
      font-size: 0.78rem;
      color: #5577aa;
      text-align: center;
      letter-spacing: 0.5px;
    }
  </style>
</head>
<body>
  <h1>🏗️ Automated Self-Healing Infrastructure</h1>

  <div class="card">
    <h2>Server Identity</h2>

    <div class="info-row">
      <span class="info-label">Hostname</span>
      <span class="info-value">{{ ansible_hostname }}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Private IP</span>
      <span class="info-value">{{ ansible_default_ipv4.address }}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Role</span>
      <span class="info-value">Backend Web Server</span>
    </div>
    <div class="info-row">
      <span class="info-label">Status</span>
      <span class="status-badge"><span class="dot"></span>ONLINE</span>
    </div>
  </div>

  <footer>College DevOps Project &mdash; Self-Healing AWS Infrastructure</footer>
</body>
</html>
